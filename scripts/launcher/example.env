# Example configuration for a full BAT3R run (Stage 1 canonical + Stage 2 bootstrapping).
# Copy this file (e.g. to my_horse.env), edit the paths, and launch with:
#   bash scripts/launcher/train_canonical.sh my_horse.env
#   bash scripts/launcher/train_bootstrap.sh my_horse.env
# Any variable below can also be overridden on the CLI, e.g.:
#   bash scripts/launcher/train_bootstrap.sh my_horse.env START_ITER=3 START_STEP=2

# Shared category & paths
CATEGORY="horse"                              # horse | chimp | elephant
DATASET_PATH="/path/to/horse_data"            # Directory with shapes/, images/, masks/, features/, train_ids.json
MODELS_ROOT="/path/to/bat3r_runs"             # Base directory for all experiment log_dirs (checkpoints + per-iter rendered output/ datasets)
PCA_PATH="assets/pcas/horse.faiss"            # Category SD-DINO PCA .faiss file
RENDER_ASSETS_DIR="assets"                    # Directory with <CATEGORY>.blend, hdrs/, and optional textures/

# Experiment names
CANON_EXP_NAME="horse_canon-1"
BOOTSTRAP_EXP_NAME="horse-1"

# Bootstrapping settings (used by train_bootstrap.sh)
CANON_CKPT="weights_80000.pth"                # Checkpoint inside CANON_EXP_NAME to initialize bootstrapping
# INITIAL_MODEL="assets/checkpoints/horse_canon.pth"  # Optional: path to a .pth file (relative to cwd, MODELS_ROOT, or absolute)
K=10
START_ITER=1
START_STEP=1
USE_PREV_DATASET=0                            # Set to 1 to also mix iteration (i-1)'s renders for i > 1

# Optional evaluation & environment settings
EVAL_DATASET_PATH=""                          # Optional external GT dataset for validation & Step 5 eval
ENV_BAT3R="bat3r"                             # Conda environment for BAT3R
ENV_SDDINO="sd-dino"                          # Conda environment for dualpm_features
ACCELERATE_CONFIG=""                          # Optional Accelerate YAML config path
KERBEROS_ENABLED=0                            # Set to 1 on Kerberos-authenticated clusters
